# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output
/cmd/**/main

# Test binary, built with `go test -c`
*.test

# Output of go coverage tool
*.out
*.prof

# Log files
*.log

# Build error logs
build_error*.log
build_errors*.txt

# Environment files - NEVER commit secrets
.env
.env.local
.env.*.local
# Ad-hoc backup/test env snapshots left behind during past work — .env.backup_m14_orig in
# particular has a real, live OpenAI API key in it (not a placeholder), so these patterns
# aren't optional cleanup, they're the difference between a public repo and a leaked key.
.env.backup*
.env.m14

# Service account credentials
service-account.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# User uploads
uploads/

# Debug & test artifacts
test_output.txt
test_results.txt
test_debug.txt
test_single.txt
debug_server*.log
server.log
startup.log
backend.log
*_stderr.log
*_stdout.log

# Seed output
seed_out.txt
seed_err.txt

# Temporary files
*.tmp
