# CV Screening Service Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# Server Configuration
PORT=8081

# App Environment - set to "production" on any publicly reachable deployment.
# When production, test/demo user seeding (CreateTestUsers) is skipped.
APP_ENV=development

# Database Configuration
DATABASE_URL=postgres://postgres:your_password_here@host:port/cv_screening?sslmode=disable

# JWT Configuration (REQUIRED - use a strong random string)
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars

# Gemini AI (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
