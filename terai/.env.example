# RecruitAI Enterprise - Frontend Environment Configuration
# 
# SECURITY NOTE: API keys are handled server-side by the backend.
# The frontend does NOT use VITE_GEMINI_API_KEY directly.
# All AI operations are proxied through the backend API for security.
#
# Copy this file to .env and configure as needed.

# Backend API URL - The backend handles all AI operations securely
VITE_API_BASE_URL=http://localhost:8081/api

# Enable mock mode for development without backend connection
# Set to 'false' when backend is running
VITE_ENABLE_MOCK=true

# LinkedIn Integration (optional)
# VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
# VITE_LINKEDIN_REDIRECT_URI=http://localhost:3000/linkedin/callback
